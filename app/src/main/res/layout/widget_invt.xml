<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_tap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView android:id="@+id/w_label"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="THIS MONTH" android:textColor="#70707A" android:textSize="10sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/w_dots"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="● ○" android:textColor="#FF000F" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="true"
            android:paddingTop="2dp">
            <TextView android:id="@+id/w_kwh"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="—" android:textColor="#FF000F" android:textSize="24sp"
                android:textStyle="bold" android:singleLine="true" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="kWh" android:textColor="#70707A" android:textSize="12sp"
                android:textStyle="bold" android:paddingStart="5dp" android:paddingLeft="5dp" />
        </LinearLayout>
        <TextView android:id="@+id/w_sub"
            android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:gravity="bottom"
            android:text="—" android:textColor="#1A1A1A" android:textSize="13sp"
            android:singleLine="true" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@drawable/widget_divider"
        android:layout_marginTop="4dp" android:layout_marginBottom="4dp"
        android:contentDescription="@null" />

    <TextView android:id="@+id/w_life"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Lifetime —" android:textColor="#70707A" android:textSize="10sp"
        android:singleLine="true" />
</LinearLayout>
