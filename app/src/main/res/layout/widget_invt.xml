<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/w_tap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:layout_width="wrap_content" android:layout_height="14dp"
                android:src="@drawable/invt_logo" android:adjustViewBounds="true"
                android:scaleType="fitStart" android:contentDescription="@null" />
            <TextView android:id="@+id/w_dots"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:gravity="end"
                android:text="● ○" android:textColor="#FF000F" android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">
            <TextView android:id="@+id/w_label"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#70707A" android:textSize="9sp"
                android:textStyle="bold" android:singleLine="true" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="13dp" android:layout_height="17dp"
                    android:src="@drawable/widget_bolt" android:contentDescription="@null" />
                <TextView android:id="@+id/w_kwh"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="#FF000F" android:textSize="27sp"
                    android:textStyle="bold" android:singleLine="true"
                    android:includeFontPadding="false"
                    android:paddingStart="3dp" android:paddingLeft="3dp" />
                <TextView
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="kWh" android:textColor="#70707A" android:textSize="12sp"
                    android:textStyle="bold" android:paddingStart="5dp" android:paddingLeft="5dp" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="2dp">
                <ImageView android:id="@+id/w_coin"
                    android:layout_width="14dp" android:layout_height="14dp"
                    android:src="@drawable/widget_coin" android:contentDescription="@null" />
                <TextView android:id="@+id/w_sub"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="—" android:textColor="#1A1A1A" android:textSize="15sp"
                    android:textStyle="bold" android:singleLine="true"
                    android:includeFontPadding="false"
                    android:paddingStart="4dp" android:paddingLeft="4dp" />
            </LinearLayout>
            <TextView android:id="@+id/w_n"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="" android:textColor="#70707A" android:textSize="11sp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@drawable/widget_divider"
        android:layout_marginTop="6dp" android:layout_marginBottom="6dp"
        android:contentDescription="@null" />

    <LinearLayout android:id="@+id/w_life_row"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Lifetime " android:textColor="#70707A" android:textSize="11sp" />
        <TextView android:id="@+id/w_life"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="—" android:textColor="#1A1A1A" android:textSize="11sp"
            android:textStyle="bold" android:singleLine="true" />
    </LinearLayout>
</LinearLayout>
